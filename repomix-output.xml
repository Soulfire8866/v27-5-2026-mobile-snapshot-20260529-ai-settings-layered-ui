              <div className="space-y-1.5 pt-1.5">
                <div className="flex items-center gap-1.5 text-zinc-450 font-bold uppercase text-[9.5px]">
                  <Info className="w-4 h-4" /> Bản mô tả máy dịch:
                </div>
                <p className="text-[11.5px] text-zinc-350 leading-relaxed font-sans italic p-2 bg-white/5 rounded-lg border border-white/5">
                  &ldquo;{activeModel.description}&rdquo;
                </p>
              </div>

            </div>

          </div>
        </div>

      </div>
    </div>
  );
}

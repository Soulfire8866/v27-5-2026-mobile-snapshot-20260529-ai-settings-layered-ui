                    {/* Chinese line */}
                    <div className="space-y-1.5">
                      <div className="text-xs text-zinc-450 dark:text-zinc-500 tracking-wide font-medium leading-relaxed">
                        {srcLine}
                      </div>
                      {srcLine.trim() && showPinyin && (
                        <div className="text-[10px] font-mono tracking-wider text-emerald-650 dark:text-emerald-400 select-all leading-normal bg-emerald-50/25 dark:bg-emerald-950/20 px-2 py-0.5 rounded border border-emerald-100/35 dark:border-emerald-900/10 max-w-max" title="Phiên âm Pinyin">
                          Pinyin: {getPinyinOfLine(srcLine)}
                        </div>
                      )}
                    </div>

                    {/* Vietnamese line with custom Playfair design */}
                    <div className="serif-reading-font">
                      {isEditingRow ? (
                        <div className="flex items-start gap-2 animate-scale-up">
                          <textarea
                            rows={Math.max(1, Math.ceil(editingText.length / 70))}
                            value={editingText}
                            onChange={(e) => setEditingText(e.target.value)}
                            className="w-full text-sm font-sans p-2 border border-amber-500 rounded-xl bg-white dark:bg-zinc-900 text-zinc-800 dark:text-zinc-100 focus:outline-none focus:ring-1 focus:ring-amber-500 font-medium leading-relaxedBox"
                            autoFocus
                          />
                          <button
                            onClick={() => handleSaveEdit(idx)}
                            className="h-10 w-10 bg-emerald-500 hover:bg-emerald-600 text-white rounded-xl flex items-center justify-center shrink-0 cursor-pointer shadow-sm active:scale-95"
                          >
                            <Check className="w-4 h-4" />
                          </button>
                        </div>
                      ) : (
                        <div
                          className="text-zinc-900 dark:text-zinc-150 text-sm md:text-base leading-relaxed cursor-pointer hover:bg-amber-55/10 rounded p-1 -m-1 font-medium text-justify"
                          onDoubleClick={() => handleStartEdit(idx)}
                        >
                          {translatedLines[idx]}
                        </div>
                      )}
                    </div>
                  </div>
                )}

                {/* Hover line action float menu */}
                {!isEditingRow && (
                  <div className="absolute right-3 top-3 opacity-0 group-hover:opacity-100 flex items-center gap-1.5 transition-opacity bg-white/80 dark:bg-zinc-900/80 p-0.5 rounded-lg border border-zinc-200/50 dark:border-zinc-800">
                    <button
                      onClick={() => handleStartEdit(idx)}
                      className="p-1.5 text-zinc-400 hover:text-amber-500 hover:bg-zinc-100 dark:hover:bg-zinc-800 rounded-lg transition-colors cursor-pointer"
                      title="Chỉnh sửa dòng dịch"
                    >
                      <Edit2 className="w-4 h-4" />
                    </button>
                    <button
                      onClick={() => copyRow(idx)}
                      className="p-1.5 text-zinc-400 hover:text-amber-500 hover:bg-zinc-100 dark:hover:bg-zinc-800 rounded-lg transition-colors cursor-pointer"
                      title="Sao chép song ngữ"
                    >
                      {copiedIndex === idx ? (
                        <CheckCircle2 className="w-4 h-4 text-emerald-500" />
                      ) : (
                        <Copy className="w-4 h-4" />
                      )}
                    </button>
                  </div>
                )}
              </div>
            );
          })
        )}
      </div>
    </div>
  );
}

              <Sparkles className="w-4.5 h-4.5 text-amber-500" /> Bảng Tra Cứu Tốc Hành
            </span>
            <button 
              onClick={() => {
                setShowQuickAddMenu(false);
                window.getSelection()?.removeAllRanges();
              }}
              className="text-zinc-500 hover:text-white transition-colors h-9 w-9 rounded-lg flex items-center justify-center cursor-pointer"
              title="Đóng popup"
            >
              <X className="w-4 h-4" />
            </button>
          </div>

          {/* Point 4 scrollable content wrapper */}
          <div className="flex-1 overflow-y-auto max-h-[45vh] lg:max-h-none space-y-4 pr-1 -mr-1 custom-scrollbar">

            {isApiKeyExpired && (
              <div className="bg-amber-970/10 border border-amber-900/50 rounded-xl p-3 text-[10px] text-amber-300 flex items-start gap-2 leading-relaxed">
                <span>⚠️</span>
                <div>
                  <span className="font-bold text-amber-250">Lỗi khóa Google:</span> Đang kích hoạt thuật toán dịch Hán Việt dự phòng. Cấp khóa API mới trong phần <span className="font-bold text-amber-400">Cài đặt</span>.
                </div>
              </div>
            )}

            {/* Original Context Line */}
            <div className="space-y-1.5">
              <div className="flex items-center justify-between gap-2 bg-black/40 p-2.5 rounded-xl border border-zinc-850">
                <button 
                  onClick={() => {
                    if (chineseParagraph && chineseWord) {
                      const idx = chineseParagraph.indexOf(chineseWord);
                      if (idx > 0) setChineseWord(chineseParagraph.substring(idx - 1, idx + chineseWord.length));
                    }
                  }}
                  className="text-zinc-550 hover:text-white h-9 w-9 rounded-xl flex items-center justify-center select-none active:bg-zinc-900 cursor-pointer"
                >
                  <ChevronLeft className="w-4.5 h-4.5" />
                </button>
                <div 
                  onMouseUp={handleChineseParagraphSelection}
                  className="text-[11px] text-zinc-350 font-mono text-center select-all cursor-pointer truncate max-w-[245px] hover:text-zinc-100 font-bold"
                  title="Bôi đen chữ Trung tương thích ở đây để nạp nhanh!"
                >
                  {(() => {
                    if (!chineseParagraph) return "Không tìm thấy đoạn gốc...";
                    if (!chineseWord) return chineseParagraph;
                    const idx = chineseParagraph.indexOf(chineseWord);
                    if (idx !== -1) {
                      return chineseParagraph.substring(idx);
                    }
                    return chineseParagraph;
                  })()}
                </div>
                <button 
                  onClick={() => {
                    if (chineseParagraph && chineseWord) {
                      const idx = chineseParagraph.indexOf(chineseWord);
                      if (idx !== -1 && idx + chineseWord.length < chineseParagraph.length) {
                        setChineseWord(chineseParagraph.substring(idx, idx + chineseWord.length + 1));
                      }
                    }
                  }}
                  className="text-zinc-550 hover:text-white h-9 w-9 rounded-xl flex items-center justify-center select-none active:bg-zinc-900 cursor-pointer"
                >
                  <ChevronRight className="w-4.5 h-4.5" />
                </button>
              </div>
              <div className="text-[10px] text-zinc-500 italic text-center select-none">
                💡 Bôi đen cụm chữ Trung để gài chữ vào ô Từ Gốc
              </div>
            </div>

            {/* Quick-translator toggle tabs (Tăng Touch Target Size h-11) */}
            <div className="flex items-center gap-1.5 border-b border-zinc-855 pb-2.5">
              <button 
                onClick={() => quickTranslate("vietphrase")}
                disabled={isTranslatingPhrase || !chineseWord}
                className="flex-1 h-11 bg-zinc-900 hover:bg-zinc-850 disabled:opacity-40 text-xs font-bold rounded-xl text-zinc-300 border border-zinc-800 flex items-center justify-center gap-1.5 transition-colors cursor-pointer active:scale-95 select-none"
              >
                Vietphrase
              </button>
              <button 
                onClick={() => quickTranslate("hanviet")}
                disabled={isTranslatingPhrase || !chineseWord}
                className="flex-1 h-11 bg-zinc-900 hover:bg-zinc-850 disabled:opacity-40 text-xs font-bold rounded-xl text-zinc-300 border border-zinc-800 flex items-center justify-center gap-1.5 transition-colors cursor-pointer active:scale-95 select-none"
              >
                Hán Việt
              </button>
            </div>

            {/* Row 4: Hán Việt translation */}
            <div className="text-xs bg-zinc-950/70 p-2.5 rounded-xl border border-zinc-850 animate-fade-in" id="popup-draft-box">
              <span className="text-[10px] text-zinc-500 block mb-1 font-bold uppercase tracking-wider">Phiên âm Hán Việt:</span>
              <span className="text-zinc-100 font-bold underline decoration-wavy decoration-emerald-500 mr-1 serif-reading-font text-sm">
                {getHanVietOffline(chineseWord, selectedText, dictItems, pronounMappings) || "..."}
              </span>
            </div>

            {/* Inputs (Touch optimized, height 11) */}
            <div className="space-y-3 bg-zinc-950/20 p-3 rounded-xl border border-zinc-850/60">
              <div className="relative">
                <span className="text-[10px] font-bold text-zinc-500 uppercase tracking-widest block mb-1 font-sans">Từ gốc Trung:</span>
                <input
                  type="text"
                  placeholder="Nạp từ gốc (Ví dụ: 飞剑)"
                  value={chineseWord}
                  onChange={(e) => setChineseWord(e.target.value.trim())}
                  className={`w-full h-11 bg-zinc-950 border border-zinc-800 rounded-lg px-3 placeholder-zinc-600 focus:outline-none focus:ring-1 focus:ring-amber-500/50 ${
                    chineseWord === "Đang tra cứu..." 
                      ? "text-amber-500 italic animate-pulse font-semibold" 
                      : "text-zinc-100 font-bold"
                  }`}
                />
              </div>

              <div className="relative">
                <span className="text-[10px] font-bold text-zinc-500 uppercase tracking-widest block mb-1 font-sans">Bản dịch khớp Việt:</span>
                <input
                  type="text"
                  placeholder="Điền nghĩa dịch Việt..."
                  value={vietnameseWord}
                  onChange={(e) => setVietnameseWord(e.target.value)}
                  className="w-full h-11 bg-zinc-950 border border-zinc-800 rounded-lg px-3 text-emerald-400 placeholder-zinc-600 focus:outline-none focus:ring-1 focus:ring-emerald-500/50 font-bold"
                />
                <button 
                  onClick={() => setVietnameseWord("")}
                  className="absolute right-2.5 top-7.5 text-zinc-500 hover:text-white h-7 w-7 flex items-center justify-center p-0.5 cursor-pointer"
                  title="Xóa trắng"
                >
                  <X className="w-3.5 h-3.5" />
                </button>
              </div>
            </div>

            {/* Casing controls (Tăng Touch Target Size h-11) */}
            <div className="flex flex-wrap items-center justify-between bg-zinc-955 p-2 rounded-xl border border-zinc-850/80 gap-1.5 select-none">
              <button 
                onClick={() => quickTranslate("vietphrase")}
                className="px-3 h-11 bg-zinc-900 border border-zinc-800 hover:bg-zinc-800 text-[11px] font-black text-zinc-400 rounded-lg cursor-pointer flex-1"
              >
                VP
              </button>
              <button 
                onClick={() => quickTranslate("hanviet")}
                className="px-3 h-11 bg-zinc-900 border border-zinc-800 hover:bg-zinc-800 text-[11px] font-black text-zinc-400 rounded-lg cursor-pointer flex-1"
              >
                HV
              </button>
              <span className="text-zinc-750 text-xs px-1 font-bold hidden sm:inline">|</span>
              
              {(["aa", "Aa1", "Aa2", "Aa", "AA"] as const).map((style) => (
                <button 
                  key={style}
                  onClick={() => applyCasing(style)}
                  className="flex-1 h-11 min-w-[40px] bg-zinc-900 hover:bg-zinc-850 text-[10px] md:text-xs font-bold text-zinc-300 rounded-lg cursor-pointer text-center active:bg-zinc-800"
                >
                  {style === "Aa1" ? "Aa¹" : style === "Aa2" ? "Aa²" : style}
                </button>
              ))}
            </div>

            {/* Custom Dictionary alignment scopes toggle (h-11) */}
            <div className="grid grid-cols-2 gap-2 text-xs select-none">
              <button
                onClick={() => setDictScope("riêng")}
                className={`h-11 rounded-xl border text-[11px] font-bold flex items-center justify-center gap-1.5 transition-all cursor-pointer ${
                  dictScope === "riêng"
                    ? "bg-amber-500/15 border-amber-500 text-amber-400 font-extrabold shadow-sm shadow-amber-500/10"
                    : "bg-zinc-900/50 border-zinc-800 text-zinc-450 hover:bg-zinc-800"
                }`}
                title="Chỉ lưu riêng cho truyện này"
              >
                📌 Riêng Truyện
              </button>
              <button
                onClick={() => setDictScope("chung")}
                className={`h-11 rounded-xl border text-[11px] font-bold flex items-center justify-center gap-1.5 transition-all cursor-pointer ${
                  dictScope === "chung"
                    ? "bg-amber-500/15 border-amber-500 text-amber-400 font-extrabold shadow-sm shadow-amber-500/10"
                    : "bg-zinc-900/50 border-zinc-800 text-zinc-450 hover:bg-zinc-800"
                }`}
                title="Lưu chung cho mọi truyện"
              >
                🌐 Chung Toàn Bộ
              </button>
            </div>

            {/* Action Trigger Submit Button (Height 12) */}
            <button
              onClick={handleQuickAddSubmit}
              disabled={!chineseWord.trim() || !vietnameseWord.trim() || isTranslatingPhrase}
              className="w-full h-12 bg-indigo-500 hover:bg-indigo-600 disabled:opacity-40 text-white font-bold rounded-xl text-xs flex items-center justify-center gap-1.5 shadow-md active:scale-98 transition-all cursor-pointer border border-indigo-400/20"
            >
              <CheckCircle className="w-4.5 h-4.5" /> Lưu Vào Bộ Nhớ Từ Điển
            </button>

            {/* Mini refs links */}
            <div className="flex items-center justify-between text-[10px] text-zinc-500 border-t border-zinc-850 pt-2 px-1 select-none font-medium">
              <a 
                href={`https://hanzii.net/search/word/${encodeURIComponent(chineseWord || selectedText)}`} 
                target="_blank" 
                rel="noreferrer"
                className="hover:text-amber-500"
              >
                Hanzii
              </a>
              <a 
                href={`https://translate.google.com/?sl=zh-CN&tl=vi&text=${encodeURIComponent(chineseWord || selectedText)}`} 
                target="_blank" 
                rel="noreferrer"
                className="hover:text-amber-500"
              >
                G.Translate
              </a>
              <a 
                href={`https://www.google.com/search?q=${encodeURIComponent(chineseWord || selectedText)}`} 
                target="_blank" 
                rel="noreferrer"
                className="hover:text-amber-500"
              >
                G.Search
              </a>
              <a 
                href={`https://baike.baidu.com/item/${encodeURIComponent(chineseWord || selectedText)}`} 
                target="_blank" 
                rel="noreferrer"
                className="hover:text-amber-500"
              >
                Baidu
              </a>
            </div>

          </div>

        </div>
      )}
      {/* Reading Core Stage Content area */}
      <div 
        ref={containerRef}
        onContextMenu={(e) => {
          // Prevent the browser default context menu on Android/long press to keep Bottom Sheet visible and uninterrupted
          e.preventDefault();
        }}
        onTouchStart={handleTouchStart}
        onTouchEnd={handleTouchEnd}
        className={`flex-1 no-callout ${readMode === "page" ? "overflow-y-hidden" : "overflow-y-auto"} custom-scrollbar select-text`}
        style={{
          width: `${settings.readerWidth}%`,
          margin: "0 auto",
          paddingLeft: `${settings.readerPaddingX !== undefined ? settings.readerPaddingX : 12}px`,
          paddingRight: `${settings.readerPaddingX !== undefined ? settings.readerPaddingX : 12}px`,
          paddingTop: "24px",
          paddingBottom: "24px"
        }}
        id="reader-stage-content"
      >
        {readMode === "page" ? (
          !isFullyTranslated && (!translatedPages || translatedPages.length === 0 || !translatedPages[currentPageIndex]) ? (
            pageTranslationError ? (
              <div className="h-full min-h-[400px] flex flex-col items-center justify-center p-10 text-center text-zinc-400 font-semibold select-none">
                <Sparkles className="w-8 h-8 mb-3 text-red-500 animate-bounce" />
                <h4 className="text-sm font-bold text-red-500 opacity-90">Lỗi dịch tự động trang {currentPageIndex + 1}</h4>
                <p className="text-xs opacity-85 max-w-sm mt-3 text-red-300 dark:text-red-400 bg-red-550/10 border border-red-550/20 px-3 py-2.5 rounded-xl leading-relaxed font-normal">
                  {pageTranslationError}
                </p>
                <button 
                  onClick={() => {
                    setPageTranslationError(null);
                    translatePageOnDemand(currentPageIndex, pages);
                  }}
                  className="mt-6 h-11 px-5 bg-amber-500 hover:bg-amber-600 text-white font-bold text-xs rounded-xl cursor-pointer hover:shadow-lg transition-all flex items-center justify-center gap-2"
                >
                  <Sparkles className="w-4 h-4 animate-spin-slow" /> Thử dịch lại trang này
                </button>
              </div>
            ) : (
              <div className="h-full min-h-[400px] flex flex-col items-center justify-center p-10 text-center text-zinc-500 dark:text-zinc-400 font-semibold select-none">
                <Sparkles className="w-8 h-8 mb-3 text-amber-500 animate-spin" />
                <h4 className="text-sm font-bold opacity-80">Đang dịch tự động trang {currentPageIndex + 1} ...</h4>
                <p className="text-xs opacity-60 mt-1 max-w-xs leading-normal">
                  Dữ liệu được chuyển mã bản địa hóa mượt mà dựa trên cẩm nang nhân xưng...
                </p>
              </div>
            )
          ) : (
            <div 
              className={`space-y-4 ${fontClasses[settings.readerFont]} ${alignmentClasses[settings.readerAlignment]} leading-relaxed`}
              style={{ 
                fontSize: `${settings.readerFontSize}px`,
                lineHeight: settings.readerLineHeight
              }}
            >
              {(isFullyTranslated 
                ? pages[currentPageIndex]?.paragraphs 
                : (translatedPages[currentPageIndex] || "").split("\n").map((text, sIdx) => ({ 
                    text, 
                    originalIndex: pages[currentPageIndex]?.paragraphs[sIdx]?.originalIndex ?? sIdx 
                  }))
              )?.map((paraObj, pIdx) => {
                if (!paraObj) return null;
                const paragraph = paraObj.text;
                const index = paraObj.originalIndex;
                if (!paragraph.trim()) return null;
                const hasChinese = /[\u4e00-\u9fa5]{3,}/.test(paragraph);
                return (
                  <p 
                    key={pIdx} 
                    data-index={index}
                    className="transition-colors duration-200 hover:text-amber-600 focus:outline-none relative group leading-relaxed text-justify"
                    style={{ marginBottom: `${settings.readerParagraphSpacing}px`, textIndent: "2.3em" }}
                  >
                    {paragraph.trim()}
                    {hasChinese && (
                      <span className="inline-flex items-center ml-2 select-none">
                        <button 
                          disabled={isTranslatingParagraphId === index}
                          onClick={(e) => {
                            e.stopPropagation();
                            handleTranslateParagraph(index, paragraph);
                          }}
                          className="inline-flex items-center gap-1.5 h-8 px-2.5 bg-amber-500/10 border border-amber-500/30 text-amber-600 dark:text-amber-400 text-[10px] font-bold rounded-lg cursor-pointer hover:bg-amber-500 hover:text-white transition-all ml-1.5"
                          title="Đoạn văn này có chứa Hán tự chưa dịch."
                        >
                          <Sparkles className="w-3.5 h-3.5 animate-pulse" />
                          {isTranslatingParagraphId === index ? "Đang dịch..." : "Dịch Hán Văn sót"}
                        </button>
                      </span>
                    )}
                  </p>
                );
              })}
            </div>
          )
        ) : (
          !currentChapter?.translatedText ? (
            <div className="h-full flex flex-col items-center justify-center p-10 text-center text-zinc-450 font-semibold select-none bg-zinc-500/5 rounded-2xl min-h-[300px]">
              <BookOpen className="w-8 h-8 mb-3 text-zinc-350" />
              <h4 className="text-sm font-bold opacity-80 animate-pulse">Nội dung chưa dịch hoặc đang trống</h4>
              <p className="text-xs opacity-60 max-w-sm mt-1 mb-5">
                Vui lòng chuyển qua Lab Dịch và bấm nút dịch để bồi đắp văn chương.
              </p>
            </div>
          ) : (
            <div 
              className={`space-y-4 ${fontClasses[settings.readerFont]} ${alignmentClasses[settings.readerAlignment]} leading-relaxed`}
              style={{ 
                fontSize: `${settings.readerFontSize}px`,
                lineHeight: settings.readerLineHeight
              }}
            >
              {currentChapter.translatedText.split('\n').map((paragraph, index) => {
                if (!paragraph.trim()) return null;
                const hasChinese = /[\u4e00-\u9fa5]{3,}/.test(paragraph);
                return (
                  <p 
                    key={index} 
                    data-index={index}
                    className="transition-colors duration-200 hover:text-amber-600 focus:outline-none relative group leading-relaxed text-justify"
                    style={{ marginBottom: `${settings.readerParagraphSpacing}px`, textIndent: "2.3em" }}
                  >
                    {paragraph.trim()}
                    {hasChinese && (
                      <span className="inline-flex items-center ml-2 select-none">
                        <button 
                          disabled={isTranslatingParagraphId === index}
                          onClick={(e) => {
                            e.stopPropagation();
                            handleTranslateParagraph(index, paragraph);
                          }}
                          className="inline-flex items-center gap-1.5 h-8 px-2.5 bg-amber-500/10 border border-amber-500/30 text-amber-600 dark:text-amber-400 text-[10px] font-bold rounded-lg cursor-pointer hover:bg-amber-500 hover:text-white transition-all ml-1.5"
                        >
                          <Sparkles className="w-3.5 h-3.5 animate-pulse" />
                          {isTranslatingParagraphId === index ? "Đang dịch..." : "Dịch đoạn sót"}
                        </button>
                      </span>
                    )}
                  </p>
                );
              })}
            </div>
          )
        )}
      </div>

      {/* Bottom pagination & navigation (Touch optimized h-14) */}
      <div className={`h-14 border-t flex items-center justify-between text-xs select-none bg-zinc-500/5 px-4 transition-all duration-300 ${
        isMobile && !showBarsOnMobile ? "hidden h-0 overflow-hidden border-t-0 p-0" : ""
      }`}>
        <button
          onClick={handlePrevPage}
          disabled={activeChapIdx <= 0 && (readMode !== "page" || currentPageIndex === 0)}
          className="flex items-center gap-1.5 p-2.5 px-3.5 hover:bg-zinc-500/10 rounded-xl disabled:opacity-30 disabled:hover:bg-transparent font-bold transition-all cursor-pointer select-none text-zinc-650 dark:text-zinc-300"
        >
          <ChevronLeft className="w-4 h-4" /> {readMode === "page" ? "Trước" : "Chương Trước"}
        </button>

        {readMode === "page" ? (
          <div className="flex items-center gap-3.5 font-bold opacity-80 text-center select-none">
            <span className="text-zinc-550 dark:text-zinc-400 font-mono text-[10px]">
              Ch{activeChapIdx + 1}/{activeNovel?.chapters.length || 0}
            </span>
            <span className="text-amber-600 dark:text-amber-400 font-mono text-[10px] font-extrabold bg-amber-500/10 px-2 py-0.5 rounded-lg border border-amber-550/20">
              Trang {currentPageIndex + 1}/{totalPages} ({(((activeChapIdx + (currentPageIndex / totalPages)) / (activeNovel?.chapters.length || 1)) * 100).toFixed(1).replace('.', ',')}%)
            </span>
          </div>
        ) : (
          <span className="font-extrabold opacity-70 font-mono text-[11px]">
            Chương {activeChapIdx + 1}/{activeNovel?.chapters.length || 0}
          </span>
        )}

        <button
          onClick={handleNextPage}
          disabled={
            readMode === "page" 
              ? (activeChapIdx >= (activeNovel?.chapters?.length || 1) - 1 && currentPageIndex >= totalPages - 1)
              : activeChapIdx >= (activeNovel?.chapters?.length || 1) - 1
          }
          className="flex items-center gap-1.5 p-2.5 px-3.5 hover:bg-zinc-500/10 rounded-xl disabled:opacity-30 disabled:hover:bg-transparent font-bold transition-all cursor-pointer select-none text-zinc-650 dark:text-zinc-300"
        >
          {readMode === "page" ? "Kế tiếp" : "Chương Sau"} <ChevronRight className="w-4 h-4" />
        </button>
      </div>

    </div>
  );
}
</file>


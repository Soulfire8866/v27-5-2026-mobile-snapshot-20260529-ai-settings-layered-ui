          <h4 className="text-[10px] font-bold uppercase tracking-wider text-amber-600 dark:text-amber-400 pb-2 border-b border-zinc-100 dark:border-zinc-800/80">Cấu hình Trang Sách</h4>
          
          <div className="space-y-3.5 text-xs">
            {/* Fonts list options */}
            <div>
              <span className="block font-bold text-zinc-450 dark:text-zinc-400 mb-1.5 uppercase text-[10px]">Kiểu chữ hiển thị:</span>
              <div className="grid grid-cols-2 gap-1.5 font-sans">
                {[
                  { id: "times", label: "Times New Roman" },

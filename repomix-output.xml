import React, { useState, useEffect } from "react";
import { Columns, Eye, Copy, Check, Edit2, CheckCircle2, ListCollapse } from "lucide-react";
import { pinyin } from "pinyin-pro";

const pinyinCache = new Map<string, string>();

function getPinyinOfLine(line: string): string {
  if (!line) return "";
  const trimmed = line.trim();
  if (!trimmed) return "";
  if (pinyinCache.has(trimmed)) {
    return pinyinCache.get(trimmed)!;
  }
  try {
    const result = pinyin(trimmed, { toneType: "symbol" });
    pinyinCache.set(trimmed, result);
    return result;
  } catch (err) {
    return "";
  }
}

interface CompareViewProps {
  sourceText: string;
  translatedText: string;
  onUpdateTranslation: (newFullText: string) => void;
}

export default function CompareView({
  sourceText,
  translatedText,
  onUpdateTranslation,
}: CompareViewProps) {
  const [viewStyle, setViewStyle] = useState<"columns" | "interleaved">("columns");
  const [showPinyin, setShowPinyin] = useState(false);
  const [sourceLines, setSourceLines] = useState<string[]>([]);
  const [translatedLines, setTranslatedLines] = useState<string[]>([]);
  const [editingIndex, setEditingIndex] = useState<number | null>(null);
  const [editingText, setEditingText] = useState("");
  const [copiedIndex, setCopiedIndex] = useState<number | null>(null);
  const [copiedAll, setCopiedAll] = useState(false);

  useEffect(() => {
    // Split texts by lines, keeping blank lines as placeholders
    const original = sourceText.replace(/\r\n/g, "\n").split("\n");
    const translated = translatedText.replace(/\r\n/g, "\n").split("\n");

    // Align both arrays by padding whichever is shorter
    const maxLines = Math.max(original.length, translated.length);
    const alignedOriginal = [...original];
    const alignedTranslated = [...translated];

    while (alignedOriginal.length < maxLines) alignedOriginal.push("");
    while (alignedTranslated.length < maxLines) alignedTranslated.push("");

    setSourceLines(alignedOriginal);
    setTranslatedLines(alignedTranslated);
  }, [sourceText, translatedText]);

  const handleStartEdit = (index: number) => {
    setEditingIndex(index);
    setEditingText(translatedLines[index]);
  };

  const handleSaveEdit = (index: number) => {
    const updated = [...translatedLines];
    updated[index] = editingText;
    setTranslatedLines(updated);
    setEditingIndex(null);
    onUpdateTranslation(updated.join("\n"));
  };

  const copyRow = (index: number) => {
    const textToCopy = `Trung: ${sourceLines[index]}\nViệt : ${translatedLines[index]}`;
    navigator.clipboard.writeText(textToCopy);
    setCopiedIndex(index);
    setTimeout(() => setCopiedIndex(null), 1500);
  };

  const copyAllVietnamese = () => {
    const cleanText = translatedLines.join("\n");
    navigator.clipboard.writeText(cleanText);
    setCopiedAll(true);
    setTimeout(() => setCopiedAll(false), 2000);
  };

  return (
    <div className="bg-transparent border-0 rounded-none p-0 md:p-3 shadow-none flex flex-col h-full animate-fade-in" id="compare-view-container">
      {/* Header controls with Win 11 modern spacing */}
      <div className="flex flex-col lg:flex-row lg:items-center justify-between gap-4 border-b border-zinc-100 dark:border-zinc-800 pb-4 mb-4">
        <div>
          <h2 className="text-base font-bold text-zinc-800 dark:text-zinc-150 flex items-center gap-2">
            <Columns className="w-5 h-5 text-amber-500" /> Đối Chiếu Song Ngữ & Hiệu Đính
          </h2>
          <p className="text-xs text-zinc-450 dark:text-zinc-400 mt-1">
            Nhấp đúp vào bất cứ dòng Việt văn nào để hiệu đính thủ công mượt mà.
          </p>
        </div>

        <div className="flex flex-wrap items-center gap-3">
          {/* View style toggles (Touch optimized h-11) */}
          <div className="bg-zinc-100 dark:bg-zinc-950 p-1 rounded-xl flex border border-zinc-200 dark:border-zinc-800/60 text-xs w-full sm:w-auto relative shrink-0">
            <button
              onClick={() => setViewStyle("columns")}
              className={`flex-1 sm:flex-initial px-4 py-2.5 h-11 rounded-lg flex items-center justify-center gap-2 font-bold transition-all cursor-pointer ${
                viewStyle === "columns"
                  ? "bg-white dark:bg-zinc-900 shadow-sm text-zinc-850 dark:text-zinc-100 border border-zinc-205/60 dark:border-zinc-800"
                  : "text-zinc-450 hover:text-zinc-850 dark:hover:text-zinc-200"
              }`}
            >
              <Columns className="w-4 h-4 text-zinc-400" /> Dạng Cột
            </button>
            <button
              onClick={() => setViewStyle("interleaved")}
              className={`flex-1 sm:flex-initial px-4 py-2.5 h-11 rounded-lg flex items-center justify-center gap-2 font-bold transition-all cursor-pointer ${
                viewStyle === "interleaved"
                  ? "bg-white dark:bg-zinc-900 shadow-sm text-zinc-850 dark:text-zinc-100 border border-zinc-205/60 dark:border-zinc-800"
                  : "text-zinc-450 hover:text-zinc-850 dark:hover:text-zinc-200"
              }`}
            >
              <ListCollapse className="w-4 h-4 text-zinc-400" /> Xen Kẽ
            </button>
          </div>

          <div className="flex items-center gap-2.5 w-full sm:w-auto self-stretch">
            {/* Copy button (Touch optimized h-11) */}
            <button
              onClick={copyAllVietnamese}
              className="flex-1 sm:flex-initial h-11 px-4 bg-zinc-900 hover:bg-zinc-800 dark:bg-zinc-100 dark:hover:bg-white text-white dark:text-zinc-900 rounded-xl text-xs font-bold flex items-center justify-center gap-2 shadow-xs transition-transform active:scale-[0.99] cursor-pointer"
              id="compare-copy-all-btn"
            >
              {copiedAll ? <Check className="w-4.5 h-4.5" /> : <Copy className="w-4.5 h-4.5" />}
              {copiedAll ? "Đã chép!" : "Copy Việt Ngữ"}
            </button>

            {/* Toggle Switch for Pinyin */}
            <div className="h-11 flex items-center gap-3 bg-zinc-50 dark:bg-zinc-950 border border-zinc-205 dark:border-zinc-800 px-4 rounded-xl text-xs select-none active:bg-zinc-100" id="compare-pinyin-container">
              <span className="text-zinc-500 dark:text-zinc-300 font-bold">Pinyin</span>
              <button
                onClick={() => setShowPinyin(!showPinyin)}
                className={`relative inline-flex h-5.5 w-10 shrink-0 cursor-pointer rounded-full border-2 border-transparent transition-colors duration-200 ease-in-out focus:outline-none ${
                  showPinyin ? "bg-emerald-500" : "bg-zinc-200 dark:bg-zinc-800"
                }`}
                id="compare-pinyin-toggle"
                aria-label="Toggle Pinyin"
              >
                <span
                  className={`pointer-events-none inline-block h-4.5 w-4.5 transform rounded-full bg-white shadow-sm ring-0 transition duration-200 ease-in-out ${
                    showPinyin ? "translate-x-4.5" : "translate-x-0"
                  }`}
                />
              </button>
            </div>
          </div>
        </div>
      </div>

      {/* Compare list stage */}
      <div 
        onContextMenu={(e) => {
          // Block native Android long press menu to protect lookup sheets
          e.preventDefault();
        }}
        className="flex-1 no-callout overflow-y-auto custom-scrollbar border-y md:border border-zinc-200 dark:border-zinc-800 rounded-none md:rounded-2xl bg-zinc-50/20 dark:bg-zinc-950/20 divide-y divide-zinc-150 dark:divide-zinc-850 p-1 lg:max-h-none h-[calc(100vh-280px)] lg:h-auto"
      >
        {sourceLines.length === 0 || (sourceLines.length === 1 && sourceLines[0] === "") ? (
          <div className="p-12 text-center text-zinc-400 dark:text-zinc-500 italic text-xs">
            Chưa có nội dung truyện để đối chiếu. Hãy tiến hành dịch thuật ở phòng làm việc.
          </div>
        ) : (
          sourceLines.map((srcLine, idx) => {

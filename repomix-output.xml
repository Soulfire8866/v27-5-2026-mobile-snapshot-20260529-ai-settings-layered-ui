          >
            {isFullscreen ? <Minimize2 className="w-4.5 h-4.5" /> : <Maximize2 className="w-4.5 h-4.5" />}
          </button>
        </div>
      </div>

      {/* Floating Settings Drawer dropdown matching Fluent Design specs */}
      {showSettings && (
